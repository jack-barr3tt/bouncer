{
  "name": "@jack-barr3tt/create-bouncer",
  "version": "0.6.0",
  "type": "module",
  "description": "Write Bouncer site files: CI pipelines, build scripts, the compose file that runs the image, and the Hello sample.",
  "license": "MIT",
  "bin": {
    "create-bouncer": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "vendor": "node --experimental-strip-types vendor.ts",
    "test": "tsc -p tsconfig.test.json && tsc && node --experimental-strip-types --test test/write.test.ts",
    "prepublishOnly": "npm run build && npm run vendor"
  },
  "files": [
    "dist",
    "vendor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jack-barr3tt/bouncer.git",
    "directory": "create"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}
