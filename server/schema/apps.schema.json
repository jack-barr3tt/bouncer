{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bouncer.local/apps.schema.json",
  "title": "App registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["apps"],
  "properties": {
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "remote"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Name used by an app's repo field."
          },
          "remote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Git remote to fetch. The deploy key must be able to read it."
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$",
            "description": "Pinned commit. A new version is published only when this changes."
          },
          "branch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Tracked branch. A push to this branch is published."
          }
        },
        "oneOf": [
          { "required": ["commit"], "not": { "required": ["branch"] } },
          { "required": ["branch"], "not": { "required": ["commit"] } }
        ]
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "description", "path", "icon"],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "not": { "enum": ["hub", "assets", "code"] },
            "description": "Directory name under apps/. hub, assets, and code are reserved."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Display name shown on the homepage card."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "One sentence shown on the homepage card."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Public path. Must be /apps/<slug>/."
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "Short text or emoji shown in the card."
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Directory of the Vite app under apps/ when it is not apps/<slug>. The files are part of this site. Cannot be combined with repo or upstream."
          },
          "repo": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Name of an entry in repos. Cannot be combined with source or upstream."
          },
          "dir": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Directory of the Vite app inside that repository. Omit when it is the repository root."
          },
          "upstream": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Origin to proxy, such as http://127.0.0.1:3000. The process must already be listening. Omit to serve files. Cannot be combined with source."
          }
        }
      }
    }
  }
}
